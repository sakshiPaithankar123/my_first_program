#include<iostream>
using namespace std;

class node{
    public:
    int data;
    node *next;
    node(int val){
        data=val;
        next=NULL;

    }

};
class linkedlist{

    private:
node* head;


public:
linkedlist()
{
    head=NULL;

}

void insert(int val){
    node* p=new node(val);
    if(head==NULL){
        head=p;

    }
    else{
        node* q=head;
        while(q->next!=NULL){
            q=q->next;
            

        }
        q->next=p;
    }
}

void display(){
    node* q=head;
    while(q!=NULL){
        cout<<q->data<<" ";
        q=q->next;
    }
    cout<<endl;
}

//deleting the first node
void remove(int x){
    node* p=NULL;
     if(head->data==x){
        p=head;
        head=head->next;
        delete p;
        return ;

     }
     
        node* q=head;
        while(q->next!=NULL){
            if(q->next->data==x){
                p=q->next;
                q->next=p->next;
                delete p;
                return;
            }
        }
     

}
void sort(){
bool swapped ;
do{
    swapped=false;
    node* q=head;
    while(q->next!=NULL)
    {
        if(q->data>q->next->data){
            int temp=q->data;
            q->data=q->next->data;
            q->next->data=temp;
            swapped=true;
        }
        q=q->next;
    }
}
while (swapped);
}




};

int main(){
    linkedlist list;

    list.insert(10);
    list.insert(20);
    list.insert(30);
    list.insert(40);

    list.display();

    list.remove(20);
    list.display();

    return 0;


}
